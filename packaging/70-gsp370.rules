# Sennheiser/EPOS GSP 370 wireless gaming headset (1395:009a)
#
# Interface 4 is the CDC-ACM settings channel used by gsp370-tray.  The HID
# interface (3) only carries consumer-control media keys and needs no rule.
#
# TAG+="uaccess" lets the currently logged-in seat user open the port without
# joining a group.  The distro's default tty group is deliberately left alone:
# Arch uses uucp, while Debian/Ubuntu/Fedora/openSUSE use dialout.  The
# installer detects the available group for its non-logind guidance.
#
# ModemManager must not probe this port: it is not a modem.  Keep this file
# below 77- so the ignore is set before ModemManager's own rules run.
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="1395", ATTRS{idProduct}=="009a", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0", TAG+="uaccess"
